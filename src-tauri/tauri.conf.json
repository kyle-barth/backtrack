{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backtrack",
  "version": "0.4.7",
  "identifier": "app.backtrack.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Backtrack",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$VIDEO/**", "$HOME/**", "$APPDATA/**", "$APPLOCALDATA/**", "$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NDgxMkNDN0Y2NkE1NUYKUldSZnBXWi96QkpJNWtleVpDYmpyNTN6MzNsSWZoaWg4NDRjNDJGYTM3ZmVpTmRXT3FIZ1AvSVMK",
      "endpoints": ["https://github.com/kyle-barth/backtrack/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" }
    }
  }
}
